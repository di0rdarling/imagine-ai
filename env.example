# =============================================================================
# Copy this file to `.env.local` and fill in values for local development.
# Never commit `.env.local` or real secrets to git.
# =============================================================================

# --- MongoDB (required for sign-up / sign-in) ---

# Full MongoDB connection string from Atlas or your host.
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/?retryWrites=true&w=majority

# Database name. Optional; defaults to "imagine-ai" if unset.
# MONGODB_DB=imagine-ai

# --- Authentication (NextAuth) ---

# Secret used to sign session JWTs and encrypt cookies.
# Required in production. Generate with: openssl rand -base64 32
# Set either NEXTAUTH_SECRET or AUTH_SECRET (both are supported).
NEXTAUTH_SECRET=
# AUTH_SECRET=

# Canonical URL of this app (used for auth callbacks).
# Local: http://localhost:3000 — use your deployed URL in production.
NEXTAUTH_URL=http://localhost:3000

# --- Google Gemini AI ---

# Google Gemini API key used for character conversations.
# Obtain a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Default model: gemini-3.5-flash
# Optional override: GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL=gemini-3.5-flash
